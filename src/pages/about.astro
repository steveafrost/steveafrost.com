---
import { Image } from "astro:assets";
import avatarImg from "../assets/avatar.jpg";
import MainLayout from "../layouts/MainLayout.astro";
const sections = [
  { title: "It started with tinkering", text: "I've been tinkering with computers for as long as I can remember—building rigs for friends, throwing together websites for local shops, and getting busted sneaking onto the family computer way past bedtime.", scene: "workbench" },
  { title: "Curiosity became a career", text: "Through the years, I turned the obsession into a career. I learned to think like an engineer, got to build things that actually excited me, and made some lifelong friends along the way.", scene: "bridge" },
  { title: "Building for people", text: "These days I build front-end tools that millions of people rely on every day. I care a lot about making the web fast, accessible, and a little more open source than I found it.", scene: "river" },
  { title: "Outside the browser", text: "When I close the laptop, you'll probably find me out on my bike or volunteering wherever I can be useful.", scene: "bicycle" },
];
---
<MainLayout glassHeader title="About | Steve Frost" description="About Steve Frost - front-end engineer, cyclist, and tree hugger.">
  <article class="about-story" data-about-story data-motion="paused">
    <img class="story-landscape" src="/about-assets/winding-story.webp" width="1122" height="1402" alt="" fetchpriority="high" />
    <header class="story-intro">
      <Image src={avatarImg} alt="Steve Frost's illustrated avatar" width={200} height={200} format="webp" quality={85} loading="eager" class="story-avatar" />
      <div>
        <h1>Building things.<br />Getting <em>outside.</em></h1>
        <p>Front-end engineer, cyclist, and tree hugger.</p>
      </div>
    </header>
    {sections.map(({title, text, scene}, i) => (
      <section class:list={["story-section", `story-section-${i + 1}`]} aria-labelledby={`story-heading-${i}`} data-story-section>
        <div class="story-copy">
          <h2 id={`story-heading-${i}`}>{title}</h2>
          <p>{text}</p>
        </div>
        <div class:list={["story-art", `story-art-${scene}`]} aria-hidden="true"></div>
      </section>
    ))}
    <div class="about-effects" data-about-effects aria-hidden="true"></div>
    <div class="about-motion-zone about-motion-zone--desk" data-motion-zone="desk" aria-hidden="true"></div>
    <div class="about-motion-zone about-motion-zone--bridge" data-motion-zone="bridge" aria-hidden="true"></div>
    <section class="story-contact" aria-labelledby="story-contact-title">
      <h2 id="story-contact-title">Get in touch</h2>
      <p>I'd love to hear from you.</p>
      <div class="story-contact-links">
        <a class="story-email" href="mailto:hello@steveafrost.com">hello@steveafrost.com</a>
        <a class="story-github" href="https://github.com/steveafrost" target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
      <button class="story-motion" type="button" data-story-pause aria-pressed="true" disabled>Motion paused</button>
    </section>
  </article>
  <script is:inline type="module" src="/about-assets/motion.mjs"></script>
  <style>
    :global(body:has(.about-story) #main){max-width:1440px;padding:0}
    :global(body:has(.about-story) #main > .about-story){max-width:none}
    .about-story{position:relative;isolation:isolate;min-height:0;aspect-ratio:1122/1402;margin-top:0;font-family:'Space Grotesk',RiverSans,sans-serif;color:var(--ink)}
    .story-landscape{position:absolute;inset:0;width:100%;height:100%;object-fit:fill;z-index:-1}
    .story-intro{position:absolute;top:7.1%;left:5.7%;right:7%;display:flex;align-items:center;gap:2.1%}
    .story-avatar{width:16.1%;height:auto;border-radius:50%;aspect-ratio:1}
    .story-intro h1{font-family:Fraunces,Georgia,serif;font-weight:700;font-variation-settings:'SOFT' 100,'WONK' 1;font-size:clamp(34px,3.35vw,48px);line-height:1.04;letter-spacing:-.035em;margin:0 0 16px}
    .story-intro em{color:#cf3d23}
    .story-intro p{font-size:clamp(17px,1.6vw,21px);line-height:1.45;margin:0;color:#35524e}
    .story-section{position:absolute;width:38%;left:7%;top:23.5%}
    .story-section-2{top:40.8%;left:60.5%;width:36%}
    .story-section-3{top:57%;width:38%}
    .story-section-4{top:73.2%;left:59.2%;width:36%}
    .story-copy h2,.story-contact h2{font:700 clamp(28px,2.65vw,38px)/1.14 Fraunces,Georgia,serif;letter-spacing:-.045em;margin:0 0 21px;text-wrap:balance}
    .story-copy h2::after,.story-contact h2::after{content:"";display:block;width:42px;border-bottom:3px solid #ef513a;margin-top:10px}
    .story-copy p,.story-contact p{font-size:clamp(16px,1.42vw,20px);line-height:1.5;margin:0;color:#3a4e58}
    .story-art{display:none}
    .story-contact{position:absolute;left:54.8%;top:85.8%;right:5%;padding-bottom:24px}
    .story-contact h2{margin-bottom:10px}
    .story-contact-links{display:flex;align-items:center;flex-wrap:wrap;gap:24px;margin-top:18px;font-size:17px}
    .story-email{background:#d53c24;color:#fff;padding:13px 20px;border-radius:5px;min-height:48px;display:inline-flex;align-items:center;overflow-wrap:anywhere}
    .story-github{text-decoration:underline;text-underline-offset:5px;padding-block:12px}
    .story-motion{display:block;background:var(--cream);border:1px solid var(--line);border-radius:24px;padding:10px 16px;min-height:44px;font-size:13px;margin-top:14px;cursor:pointer}
    .story-motion:disabled{cursor:default;color:var(--olive)}
    .about-effects{position:absolute;left:15.1515%;top:24.9643%;width:59.7148%;height:22.8245%;pointer-events:none}
    .about-effects :global(.about-pixi-canvas){display:block;width:100%;height:100%;pointer-events:none}
    .about-motion-zone{position:absolute;pointer-events:none}
    .about-motion-zone--desk{left:49%;top:26%;width:20%;height:9%}
    .about-motion-zone--bridge{left:16%;top:40%;width:38%;height:8%}
    :global([data-theme="night"]) .about-story{--ink:#132b28;--cream:#f7f4eb;--line:#dfded1;background:#f7f4eb;color:#132b28}
    :global([data-theme="night"]) .about-story a:focus-visible,:global([data-theme="night"]) .about-story button:focus-visible{outline-color:#cf3d23}
    @media(min-width:1440px){.story-copy p{font-size:20px}}
    @media(max-width:1099px){
      .about-story{aspect-ratio:auto;margin-top:0;padding:112px 24px 48px;background:#f7f4eb;--ink:#132b28;--cream:#f7f4eb;--line:#dfded1}
      .story-landscape{display:none}
      .story-intro{position:static;gap:24px;align-items:center;margin-bottom:40px}
      .story-avatar{width:112px;flex-shrink:0}
      .story-intro h1{font-size:38px}
      .story-intro p{font-size:18px}
      .story-section,.story-section-2,.story-section-3,.story-section-4{position:static;width:100%;max-width:680px;margin:0 auto 36px}
      .story-copy h2,.story-contact h2{font-size:30px}
      .story-copy p,.story-contact p{font-size:18px;line-height:1.65}
      .story-art{display:block;height:240px;margin-top:22px;background-image:url('/about-assets/winding-story.webp');background-repeat:no-repeat;background-size:180% auto}
      .story-art-workbench{background-position:100% 24%}
      .story-art-bridge{background-position:0 48%}
      .story-art-river{background-position:100% 68%}
      .story-art-bicycle{background-position:0 87%}
      .story-contact{position:static;max-width:680px;margin:20px auto 0;padding:0}
      .about-effects,.about-motion-zone{display:none}
      .story-motion{display:none}
    }
    @media(max-width:520px){
      .story-intro{gap:18px;align-items:flex-start}
      .story-avatar{width:76px}
      .story-intro h1{font-size:29px;margin-bottom:12px}
      .story-intro p{font-size:16px}
      .story-copy h2,.story-contact h2{font-size:29px}
      .story-art{height:200px;background-size:220% auto}
      .story-contact-links{gap:18px;font-size:16px}
    }
    @media(max-width:760px){.about-story{padding-top:156px}}
    :global(html:has(.about-story)){scroll-padding-top:112px}
    :global(body:has(.about-story) .skip:focus){z-index:51}
    @media(max-width:760px){:global(html:has(.about-story)){scroll-padding-top:152px}}
  </style>
</MainLayout>
