---
import MockBanner from '../../../components/MockBanner.astro';
---
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Plex Watchdog - Mock</title>
  <style>
    *{margin:0;padding:0;box-sizing:border-box}
    body{font-family:'SF Mono','Fira Code','JetBrains Mono',monospace;background:#0a0a0a;min-height:100vh;color:#e4e4e7;padding:20px;display:flex;justify-content:center}
    .container{max-width:900px;width:100%}

    /* Terminal window */
    .terminal{background:#18181b;border:1px solid #27272a;border-radius:10px;overflow:hidden;margin-bottom:24px;box-shadow:0 4px 24px rgba(0,0,0,0.4)}
    .terminal-bar{display:flex;align-items:center;gap:8px;padding:12px 16px;background:#27272a;border-bottom:1px solid #333}
    .terminal-dot{width:12px;height:12px;border-radius:50%}
    .terminal-dot.red{background:#ff5f57}
    .terminal-dot.yellow{background:#febc2e}
    .terminal-dot.green{background:#28c840}
    .terminal-title{flex:1;text-align:center;font-size:13px;color:#71717a}
    .terminal-body{padding:20px;font-size:13px;line-height:1.7;overflow-x:auto}

    /* Shell script syntax highlighting */
    .shebang{color:#f59e0b}
    .comment{color:#71717a;font-style:italic}
    .keyword{color:#c678dd}
    .function{color:#61afef}
    .string{color:#98c379}
    .variable{color:#e06c75}
    .builtin{color:#56b6c2}
    .prompt{color:#22c55e}
    .cmd{color:#e4e4e7}
    .output{color:#a1a1aa}
    .success{color:#22c55e}
    .warning{color:#f59e0b}
    .error{color:#ef4444}
    .info{color:#3b82f6}
    .dim{opacity:0.6}

    .line{white-space:pre}

    /* Feature cards */
    .features{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:16px;margin-top:24px}
    .feature{background:#18181b;border:1px solid #27272a;border-radius:8px;padding:20px}
    .feature-icon{font-size:24px;margin-bottom:8px}
    .feature h3{font-size:15px;font-weight:600;margin-bottom:8px;font-family:'SF Mono','Fira Code',monospace;color:#e4e4e7}
    .feature p{font-size:13px;color:#71717a;line-height:1.6;font-family:-apple-system,sans-serif}

    h2{font-family:-apple-system,sans-serif;font-size:20px;color:#a1a1aa;margin-bottom:16px;font-weight:600}
  </style>
</head>
<body>
  <MockBanner projectName="Plex Watchdog" />
  <div class="container">
    <!-- Install terminal -->
    <div class="terminal">
      <div class="terminal-bar">
        <span class="terminal-dot red"></span>
        <span class="terminal-dot yellow"></span>
        <span class="terminal-dot green"></span>
        <span class="terminal-title">plex-watchdog — install</span>
      </div>
      <div class="terminal-body">
        <div class="line"><span class="prompt">$ </span><span class="cmd">curl -fsSL https://raw.githubusercontent.com/steveafrost/plex-watchdog-macos/main/install-watchdog.sh | bash</span></div>
        <div class="line">&nbsp;</div>
        <div class="line"><span class="info">ℹ</span> <span class="output">Installing Plex Watchdog for macOS...</span></div>
        <div class="line"><span class="success">✓</span> <span class="output">Plex Media Server found at /Applications/</span></div>
        <div class="line"><span class="success">✓</span> <span class="output">Created LaunchAgents directory</span></div>
        <div class="line"><span class="success">✓</span> <span class="output">Copied watchdog scripts to ~/.plex-watchdog/</span></div>
        <div class="line"><span class="success">✓</span> <span class="output">Generated LaunchAgent plist</span></div>
        <div class="line"><span class="success">✓</span> <span class="output">Loaded service: com.plex.watchdog</span></div>
        <div class="line">&nbsp;</div>
        <div class="line"><span class="prompt">$ </span><span class="cmd">plex-watchdog status</span></div>
        <div class="line"><span class="success">●</span> <span class="output">Watchdog is running (PID: 12345)</span></div>
      </div>
    </div>

    <!-- Health check code -->
    <div class="terminal">
      <div class="terminal-bar">
        <span class="terminal-dot red"></span>
        <span class="terminal-dot yellow"></span>
        <span class="terminal-dot green"></span>
        <span class="terminal-title">plex-watchdog.sh — health checks</span>
      </div>
      <div class="terminal-body">
        <div class="line"><span class="shebang">#!/bin/bash</span></div>
        <div class="line">&nbsp;</div>
        <div class="line"><span class="comment"># Check if Plex process is running</span></div>
        <div class="line"><span class="function">check_process</span>() {"{"}</div>
        <div class="line">    <span class="keyword">if</span> <span class="builtin">pgrep</span> -x <span class="string">"Plex Media Server"</span> > /dev/null 2>&1; <span class="keyword">then</span></div>
        <div class="line">        <span class="keyword">return</span> 0</div>
        <div class="line">    <span class="keyword">else</span></div>
        <div class="line">        <span class="keyword">return</span> 1</div>
        <div class="line">    <span class="keyword">fi</span></div>
        <div class="line">{"}"}</div>
        <div class="line">&nbsp;</div>
        <div class="line"><span class="comment"># Check if Plex web interface responds</span></div>
        <div class="line"><span class="function">check_web_health</span>() {"{"}</div>
        <div class="line">    <span class="keyword">local</span> <span class="variable">response</span></div>
        <div class="line">    <span class="variable">response</span>=$(<span class="builtin">curl</span> -s -o /dev/null -w <span class="string">"%&lbrace;http_code&rbrace;"</span> \</div>
        <div class="line">        <span class="string">"$HEALTH_CHECK_URL"</span> 2>/dev/null)</div>
        <div class="line">    <span class="keyword">if</span> [ <span class="string">"<span class="variable">$response</span>"</span> = <span class="string">"200"</span> ]; <span class="keyword">then</span></div>
        <div class="line">        <span class="keyword">return</span> 0</div>
        <div class="line">    <span class="keyword">else</span></div>
        <div class="line">        <span class="keyword">return</span> 1</div>
        <div class="line">    <span class="keyword">fi</span></div>
        <div class="line">{"}"}</div>
      </div>
    </div>

    <!-- Restart logic code -->
    <div class="terminal">
      <div class="terminal-bar">
        <span class="terminal-dot red"></span>
        <span class="terminal-dot yellow"></span>
        <span class="terminal-dot green"></span>
        <span class="terminal-title">plex-watchdog.sh — restart logic</span>
      </div>
      <div class="terminal-body">
        <div class="line"><span class="function">restart_plex</span>() {"{"}</div>
        <div class="line">    <span class="function">log</span> <span class="string">"Restarting Plex Media Server..."</span></div>
        <div class="line">&nbsp;</div>
        <div class="line">    <span class="comment"># Kill existing processes</span></div>
        <div class="line">    <span class="builtin">pkill</span> -x <span class="string">"Plex Media Server"</span> 2>/dev/null</div>
        <div class="line">    <span class="builtin">sleep</span> 2</div>
        <div class="line">    <span class="builtin">pkill</span> -9 -x <span class="string">"Plex Media Server"</span> 2>/dev/null</div>
        <div class="line">&nbsp;</div>
        <div class="line">    <span class="comment"># Wait for clean shutdown</span></div>
        <div class="line">    <span class="builtin">sleep</span> 3</div>
        <div class="line">&nbsp;</div>
        <div class="line">    <span class="comment"># Start Plex</span></div>
        <div class="line">    <span class="builtin">open</span> -a <span class="string">"Plex Media Server"</span></div>
        <div class="line">&nbsp;</div>
        <div class="line">    <span class="comment"># Wait for startup and verify</span></div>
        <div class="line">    <span class="keyword">local</span> <span class="variable">count</span>=0</div>
        <div class="line">    <span class="keyword">while</span> [ <span class="variable">$count</span> -lt <span class="variable">$MAX_STARTUP_TIME</span> ]; <span class="keyword">do</span></div>
        <div class="line">        <span class="builtin">sleep</span> 1</div>
        <div class="line">        <span class="keyword">if</span> <span class="function">check_web_health</span>; <span class="keyword">then</span></div>
        <div class="line">            <span class="function">log</span> <span class="string">"✓ Plex restarted successfully!"</span></div>
        <div class="line">            <span class="keyword">return</span> 0</div>
        <div class="line">        <span class="keyword">fi</span></div>
        <div class="line">        <span class="variable">count</span>=$((<span class="variable">count</span> + 1))</div>
        <div class="line">    <span class="keyword">done</span></div>
        <div class="line">{"}"}</div>
      </div>
    </div>

    <!-- Control commands -->
    <div class="terminal">
      <div class="terminal-bar">
        <span class="terminal-dot red"></span>
        <span class="terminal-dot yellow"></span>
        <span class="terminal-dot green"></span>
        <span class="terminal-title">plex-watchdog-ctl — commands</span>
      </div>
      <div class="terminal-body">
        <div class="line"><span class="prompt">$ </span><span class="cmd">plex-watchdog status</span></div>
        <div class="line"><span class="success">●</span> <span class="output">Running — PID 12345, last check: 14:32:05</span></div>
        <div class="line">&nbsp;</div>
        <div class="line"><span class="prompt">$ </span><span class="cmd">plex-watchdog logs</span></div>
        <div class="line"><span class="dim">[2025-02-17 14:30:05]</span> <span class="success">Health check passed</span></div>
        <div class="line"><span class="dim">[2025-02-17 14:31:05]</span> <span class="success">Health check passed</span></div>
        <div class="line"><span class="dim">[2025-02-17 14:32:05]</span> <span class="warning">⚠ Plex not responding</span></div>
        <div class="line"><span class="dim">[2025-02-17 14:32:08]</span> <span class="success">✓ Plex restarted</span></div>
        <div class="line">&nbsp;</div>
        <div class="line"><span class="prompt">$ </span><span class="cmd">plex-watchdog test-crash</span></div>
        <div class="line"><span class="warning">⚠</span> <span class="output">Killing Plex to test recovery...</span></div>
        <div class="line"><span class="info">ℹ</span> <span class="output">Watchdog should restart within 60 seconds</span></div>
      </div>
    </div>

    <h2>Features</h2>
    <div class="features">
      <div class="feature">
        <div class="feature-icon">👁️</div>
        <h3>Dual Monitoring</h3>
        <p>Checks both process status and web interface health every 60 seconds for comprehensive crash detection.</p>
      </div>
      <div class="feature">
        <div class="feature-icon">🔄</div>
        <h3>Auto Recovery</h3>
        <p>Kills stale processes gracefully, waits for clean shutdown, then restarts Plex and verifies it's back online.</p>
      </div>
      <div class="feature">
        <div class="feature-icon">📝</div>
        <h3>Crash Logging</h3>
        <p>All crashes and recoveries logged with timestamps to ~/Library/Logs/PlexWatchdog/ for tracking stability.</p>
      </div>
      <div class="feature">
        <div class="feature-icon">⚡</div>
        <h3>LaunchAgent</h3>
        <p>Runs as a native macOS LaunchAgent. Starts automatically on boot and survives user logouts.</p>
      </div>
    </div>
  </div>
</body>
</html>
