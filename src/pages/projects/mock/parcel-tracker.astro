---
import MockBanner from '../../../components/MockBanner.astro';
---
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Parcel Tracker - Mock</title>
  <style>
    *{margin:0;padding:0;box-sizing:border-box}
    body{font-family:'SF Mono','Fira Code','JetBrains Mono',monospace;background:#0a0a0a;min-height:100vh;color:#e4e4e7;padding:20px;display:flex;justify-content:center}
    .container{max-width:900px;width:100%}

    /* Terminal window */
    .terminal{background:#18181b;border:1px solid #27272a;border-radius:10px;overflow:hidden;margin-bottom:24px;box-shadow:0 4px 24px rgba(0,0,0,0.4)}
    .terminal-bar{display:flex;align-items:center;gap:8px;padding:12px 16px;background:#27272a;border-bottom:1px solid #333}
    .terminal-dot{width:12px;height:12px;border-radius:50%}
    .terminal-dot.red{background:#ff5f57}
    .terminal-dot.yellow{background:#febc2e}
    .terminal-dot.green{background:#28c840}
    .terminal-title{flex:1;text-align:center;font-size:13px;color:#71717a}
    .terminal-body{padding:20px;font-size:14px;line-height:1.8;overflow-x:auto}

    /* Prompt styles */
    .prompt{color:#22c55e}
    .cmd{color:#e4e4e7}
    .comment{color:#71717a}
    .output{color:#a1a1aa}
    .success{color:#22c55e}
    .info{color:#3b82f6}
    .url{color:#a78bfa}
    .json-key{color:#60a5fa}
    .json-str{color:#34d399}
    .json-bool{color:#f59e0b}
    .json-num{color:#f472b6}
    .dim{opacity:0.6}

    .line{white-space:pre}

    /* Feature cards */
    .features{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:16px;margin-top:24px}
    .feature{background:#18181b;border:1px solid #27272a;border-radius:8px;padding:20px}
    .feature-icon{font-size:24px;margin-bottom:8px}
    .feature h3{font-size:15px;font-weight:600;margin-bottom:8px;font-family:'SF Mono','Fira Code',monospace;color:#e4e4e7}
    .feature p{font-size:13px;color:#71717a;line-height:1.6;font-family:-apple-system,sans-serif}

    h2{font-family:-apple-system,sans-serif;font-size:20px;color:#a1a1aa;margin-bottom:16px;font-weight:600}

    /* Package card */
    .package-card{background:#18181b;border:1px solid #27272a;border-radius:8px;padding:16px;margin-bottom:12px;display:flex;align-items:center;gap:16px}
    .package-icon{font-size:28px}
    .package-info{flex:1}
    .package-carrier{font-size:12px;color:#71717a;text-transform:uppercase;letter-spacing:0.05em}
    .package-tracking{font-size:14px;color:#e4e4e7;font-family:'SF Mono',monospace;margin-top:4px}
    .package-status{font-size:12px;padding:4px 10px;border-radius:4px;background:#22c55e20;color:#22c55e}
    .package-status.delivered{background:#22c55e20;color:#22c55e}
    .package-status.transit{background:#3b82f620;color:#3b82f6}
  </style>
</head>
<body>
  <MockBanner projectName="Parcel Tracker" />
  <div class="container">
    <!-- Server startup terminal -->
    <div class="terminal">
      <div class="terminal-bar">
        <span class="terminal-dot red"></span>
        <span class="terminal-dot yellow"></span>
        <span class="terminal-dot green"></span>
        <span class="terminal-title">parcel-tracker — docker</span>
      </div>
      <div class="terminal-body">
        <div class="line"><span class="prompt">$ </span><span class="cmd">docker-compose up -d</span></div>
        <div class="line"><span class="info">ℹ</span> <span class="output">Starting parcel-tracker...</span></div>
        <div class="line"><span class="success">✓</span> <span class="output">Connected to iCloud Mail via IMAP</span></div>
        <div class="line"><span class="success">✓</span> <span class="output">Database initialized (SQLite)</span></div>
        <div class="line"><span class="success">✓</span> <span class="output">Parcel API integration ready</span></div>
        <div class="line"><span class="success">✓</span> <span class="output">Email polling every 5 minutes</span></div>
        <div class="line">&nbsp;</div>
        <div class="line"><span class="comment"># API Endpoints</span></div>
        <div class="line"><span class="url">GET  /health</span><span class="dim">     → Service health check</span></div>
        <div class="line"><span class="url">GET  /packages</span><span class="dim">    → List all tracked packages</span></div>
        <div class="line"><span class="url">POST /packages</span><span class="dim">    → Manually add tracking number</span></div>
      </div>
    </div>

    <!-- Tracked packages -->
    <h2>Recently Tracked</h2>
    <div class="package-card">
      <span class="package-icon">📦</span>
      <div class="package-info">
        <div class="package-carrier">UPS Ground</div>
        <div class="package-tracking">1Z999AA10123456784</div>
      </div>
      <span class="package-status delivered">Delivered</span>
    </div>
    <div class="package-card">
      <span class="package-icon">📦</span>
      <div class="package-info">
        <div class="package-carrier">FedEx</div>
        <div class="package-tracking">784512349012</div>
      </div>
      <span class="package-status transit">In Transit</span>
    </div>
    <div class="package-card">
      <span class="package-icon">📦</span>
      <div class="package-info">
        <div class="package-carrier">USPS Priority</div>
        <div class="package-tracking">9400100000000000000001</div>
      </div>
      <span class="package-status transit">In Transit</span>
    </div>

    <h2>Features</h2>
    <div class="features">
      <div class="feature">
        <div class="feature-icon">📧</div>
        <h3>IMAP Monitoring</h3>
        <p>Connects to iCloud Mail and automatically scans for new shipping emails from major carriers.</p>
      </div>
      <div class="feature">
        <div class="feature-icon">🔍</div>
        <h3>Smart Extraction</h3>
        <p>Detects tracking numbers from UPS, FedEx, USPS, Amazon, DHL, and more using pattern matching.</p>
      </div>
      <div class="feature">
        <div class="feature-icon">📲</div>
        <h3>Auto-Submit</h3>
        <p>Automatically submits extracted tracking numbers to your Parcel app for unified tracking.</p>
      </div>
      <div class="feature">
        <div class="feature-icon">🐳</div>
        <h3>Docker Ready</h3>
        <p>Self-hosted with Docker Compose. SQLite database persists between restarts.</p>
      </div>
    </div>
  </div>
</body>
</html>
