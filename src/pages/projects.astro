---
import MainLayout from "../layouts/MainLayout.astro";
import ProjectEntry from "../components/ProjectEntry.astro";
import { projects } from "../data/projects";
---
<MainLayout title="Projects | Steve Frost" description="Selected projects by Steve Frost.">
  <section class="portfolio-work" aria-labelledby="projects-title">
    <img class="projects-branch" src="/projects-assets/branch.webp" width="512" height="220" alt="" aria-hidden="true" />
    <div class="work-container">
      <header class="work-heading">
        <h1 id="projects-title">Projects</h1>
        <p>Selected work spanning tour websites, e-commerce, developer tools, and personal projects.</p>
      </header>
      <div class="work-featured" aria-label="Featured projects">
        {projects.slice(0, 2).map(project => <ProjectEntry project={project} featured />)}
      </div>
      <div class="work-list" aria-label="More projects">
        {projects.slice(2).map(project => <ProjectEntry project={project} />)}
      </div>
    </div>
    <div class="projects-river" aria-hidden="true"><img src="/projects-assets/river-footer.webp" width="1600" height="350" alt="" loading="lazy" decoding="async" /></div>
  </section>
  <style>
    .portfolio-work{position:relative;padding-top:16px;--red:#bf321e}
    :global([data-theme="night"]) .portfolio-work{--red:#ffa58c}
    .work-container{max-width:1200px;margin-inline:auto}
    .work-heading{margin-bottom:48px}
    .work-heading h1{font:700 clamp(42px,5.6vw,80px)/1.08 Fraunces,Georgia,serif;font-variation-settings:'SOFT' 100,'WONK' 1;letter-spacing:-.045em;color:var(--ink);margin:0 0 14px}
    .work-heading p{font:400 20px/1.55 'Space Grotesk',RiverSans,sans-serif;color:var(--olive);margin:0;max-width:100%}
    .work-featured{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:48px}
    .work-list{margin-top:52px}
    .projects-branch{position:absolute;left:calc(-1 * var(--gutter));top:-90px;width:210px;height:auto;pointer-events:none;z-index:0}
    .work-heading,.work-featured,.work-list{position:relative}
    .projects-river{margin:32px calc(-1 * var(--gutter)) -28px;overflow:hidden}
    .projects-river img{width:100%;height:clamp(160px,22vw,320px);object-fit:cover;object-position:center bottom}
    @media(max-width:899px){.work-featured{grid-template-columns:1fr;gap:40px}.work-heading{margin-bottom:32px}.work-heading h1{font-size:48px}.work-heading p{font-size:18px}.work-list{margin-top:36px}}
    @media(max-width:520px){.portfolio-work{padding-top:0}.work-heading h1{font-size:40px}.work-heading p{font-size:16px;line-height:1.6}.projects-branch{display:none}.projects-river img{height:160px}}
  </style>
</MainLayout>
