---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
const articles = await getCollection('articles', ({ data }) => !data.draft);
const recentArticles = articles.sort((a,b) => b.data.date.getTime()-a.data.date.getTime()).slice(0,4);
const formatDate = (date: Date): string => date.toLocaleDateString('en-US', {year:'numeric', month:'short', day:'numeric', timeZone:'UTC'});
---
<MainLayout home>
<section class="landscape" aria-label="A moment on the river"><img class="river-picture" src="/river-assets/river-full-bleed.png" alt="An illustrated river winding past wooded banks, an arched bridge, and an Ann Arbor inspired skyline."><canvas class="river-water" aria-hidden="true"></canvas><div class="boat-position"><img class="boat" src="/river-assets/boat.png" alt="" aria-hidden="true"></div><button class="river-explore" aria-label="Explore the river with arrow keys or touch">Explore the river</button><button class="motion-toggle" aria-pressed="false">Pause motion</button><p class="sr-only" data-motion-status aria-live="polite"></p></section><section class="intro wrap"><h1>Useful things, made with curiosity.</h1><p>Software projects and notes by Steve Frost.</p></section><section class="postcards wrap" aria-label="Personal projects"><a class="postcard kindle" href="/articles/building-a-nightly-newspaper-for-my-kindle"><div class="postcard-art"><img src="/river-assets/kindle.png" alt="" width="1536" height="1024"></div><h2>Kindle newspaper</h2><p>A nightly edition for my Kindle.</p></a><a class="postcard parcel" href="/articles/parcelrouter-from-inbox-script-to-package-event-router"><div class="postcard-art"><img src="/river-assets/parcel.png" alt="" width="1536" height="1024"></div><h2>ParcelRouter</h2><p>Shipping emails to package events.</p></a><a class="postcard gif" href="/articles/making-gifs-small-enough-for-a-conversation"><div class="postcard-art"><img src="/river-assets/gif.png" alt="" width="1536" height="1024"></div><h2>Tiny GIFs</h2><p>Good motion, smaller files.</p></a></section><section class="writing wrap"><div class="writing-heading"><h2>Recently written</h2><a href="/articles">All writing</a></div>{recentArticles.map((article) => <a class="writing-row" href={`/articles/${article.id}`}><span>{article.data.title}</span><time datetime={article.data.date.toISOString()}>{formatDate(article.data.date)}</time></a>)}</section>
</MainLayout>
