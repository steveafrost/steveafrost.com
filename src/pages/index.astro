---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
const articles = await getCollection('articles', ({ data }) => !data.draft);
const recentArticles = articles.sort((a,b) => b.data.date.getTime()-a.data.date.getTime()).slice(0,4);
const formatDate = (date: Date): string => date.toLocaleDateString('en-US', {year:'numeric', month:'short', day:'numeric', timeZone:'UTC'});
---
<MainLayout home>
<section class="landscape" aria-label="A moment on the river"><img class="river-picture" src="/river-assets/river-full-bleed.png" data-day="/river-assets/river-full-bleed.png" data-night="/river-assets/river-night-sky.png" alt="An illustrated river winding past wooded banks, an arched bridge, and an Ann Arbor inspired skyline."><script is:inline>if(document.documentElement.dataset.theme==='night')document.querySelector('.river-picture').src='/river-assets/river-night-sky.png'</script><button class="theme-toggle theme-sun" aria-label="Switch to night" title="Switch to night"><span class="sr-only">Change theme</span></button><div class="day-lamps" aria-hidden="true"><svg viewBox="452 176 341 946" width="341" height="946" data-x="0.357505" data-y="0.620166" data-height="18"><image href="/river-assets/day-lamp.png" width="1243" height="1266" /></svg><svg viewBox="452 176 341 946" width="341" height="946" data-x="0.368094" data-y="0.61395" data-height="27"><image href="/river-assets/day-lamp.png" width="1243" height="1266" /></svg><svg viewBox="452 176 341 946" width="341" height="946" data-x="0.402164" data-y="0.622928" data-height="23"><image href="/river-assets/day-lamp.png" width="1243" height="1266" /></svg><svg viewBox="452 176 341 946" width="341" height="946" data-x="0.429098" data-y="0.618785" data-height="29"><image href="/river-assets/day-lamp.png" width="1243" height="1266" /></svg><svg viewBox="452 176 341 946" width="341" height="946" data-x="0.469843" data-y="0.623619" data-height="29"><image href="/river-assets/day-lamp.png" width="1243" height="1266" /></svg><svg viewBox="452 176 341 946" width="341" height="946" data-x="0.517035" data-y="0.629144" data-height="27"><image href="/river-assets/day-lamp.png" width="1243" height="1266" /></svg></div><canvas class="river-water" aria-hidden="true"></canvas><button class="motion-toggle" aria-pressed="false">Pause motion</button><p class="sr-only" data-motion-status aria-live="polite"></p></section><section class="intro wrap"><h1>Useful things, made with curiosity.</h1><p>Software projects and notes by Steve Frost.</p></section><section class="postcards wrap" aria-label="Personal projects"><a class="postcard kindle" href="/articles/building-a-nightly-newspaper-for-my-kindle"><div class="postcard-art"><img src="/river-assets/kindle.png" alt="" width="1536" height="1024"></div><h2>Kindle newspaper</h2><p>A nightly edition for my Kindle.</p></a><a class="postcard parcel" href="/articles/parcelrouter-from-inbox-script-to-package-event-router"><div class="postcard-art"><img src="/river-assets/parcel.png" alt="" width="1536" height="1024"></div><h2>ParcelRouter</h2><p>Shipping emails to package events.</p></a><a class="postcard gif" href="/articles/making-gifs-small-enough-for-a-conversation"><div class="postcard-art"><img src="/river-assets/gif.png" alt="" width="1536" height="1024"></div><h2>Tiny GIFs</h2><p>Good motion, smaller files.</p></a></section><section class="writing wrap"><div class="writing-heading"><h2>Recently written</h2><a href="/articles">All writing</a></div>{recentArticles.map((article) => <a class="writing-row" href={`/articles/${article.id}`}><span>{article.data.title}</span><time datetime={article.data.date.toISOString()}>{formatDate(article.data.date)}</time></a>)}</section>
</MainLayout>
