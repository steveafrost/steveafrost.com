---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import RecentWriting from '../components/RecentWriting.astro';
const articles = await getCollection('articles', ({ data }) => !data.draft);
const recentArticles = articles.sort((a,b) => b.data.date.getTime()-a.data.date.getTime()).slice(0,4);
---
<MainLayout home>
<section class="landscape" aria-label="A moment on the river"><img class="river-picture" src="/river-assets/river-full-bleed.png" data-day="/river-assets/river-full-bleed.png" data-night="/river-assets/river-night-sky.png" alt="An illustrated river winding past wooded banks, an arched bridge, and an Ann Arbor inspired skyline."><script is:inline>if(document.documentElement.dataset.theme==='night')document.querySelector('.river-picture').src='/river-assets/river-night-sky.png'</script><button class="theme-toggle theme-sun" aria-label="Switch to night" title="Switch to night"><span class="sr-only">Change theme</span></button><svg class="lamp-repairs" aria-hidden="true" viewBox="0 0 2172 724" preserveAspectRatio="none"><defs><clipPath id="lamp-clearing"><rect x="764.501" y="435.000" width="24" height="36" /><rect x="787.500" y="430.500" width="24" height="45" /><rect x="861.500" y="437.000" width="24" height="41" /><rect x="920.001" y="434.000" width="24" height="47" /><rect x="1008.499" y="437.500" width="24" height="47" /><rect x="1111.000" y="441.500" width="24" height="45" /></clipPath></defs><image class="lamp-repair-day" href="/river-assets/day-lamp-repair.png" width="2172" height="724" clip-path="url(#lamp-clearing)" /><image class="lamp-repair-night" href="/river-assets/night-lamp-repair.png" width="2172" height="724" clip-path="url(#lamp-clearing)" /></svg><div class="bridge-lamps" aria-hidden="true"><svg viewBox="452 176 341 946" width="341" height="946" data-x="0.357505" data-y="0.620166" data-height="18"><image href="/river-assets/day-lamp.png" width="1243" height="1266" /></svg><svg viewBox="452 176 341 946" width="341" height="946" data-x="0.368094" data-y="0.61395" data-height="27"><image href="/river-assets/day-lamp.png" width="1243" height="1266" /></svg><svg viewBox="452 176 341 946" width="341" height="946" data-x="0.402164" data-y="0.622928" data-height="23"><image href="/river-assets/day-lamp.png" width="1243" height="1266" /></svg><svg viewBox="452 176 341 946" width="341" height="946" data-x="0.429098" data-y="0.618785" data-height="29"><image href="/river-assets/day-lamp.png" width="1243" height="1266" /></svg><svg viewBox="452 176 341 946" width="341" height="946" data-x="0.469843" data-y="0.623619" data-height="29"><image href="/river-assets/day-lamp.png" width="1243" height="1266" /></svg><svg viewBox="452 176 341 946" width="341" height="946" data-x="0.517035" data-y="0.629144" data-height="27"><image href="/river-assets/day-lamp.png" width="1243" height="1266" /></svg></div><canvas class="river-water" aria-hidden="true"></canvas><p class="sr-only" data-motion-status aria-live="polite"></p></section><button class="motion-toggle" aria-label="Pause motion" title="Pause motion" aria-pressed="false"><svg class="motion-pause" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon">
  <path d="M5.75 3a.75.75 0 0 0-.75.75v12.5c0 .414.336.75.75.75h1.5a.75.75 0 0 0 .75-.75V3.75A.75.75 0 0 0 7.25 3h-1.5ZM12.75 3a.75.75 0 0 0-.75.75v12.5c0 .414.336.75.75.75h1.5a.75.75 0 0 0 .75-.75V3.75a.75.75 0 0 0-.75-.75h-1.5Z"/>
</svg><svg class="motion-play" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon">
  <path d="M6.3 2.84A1.5 1.5 0 0 0 4 4.11v11.78a1.5 1.5 0 0 0 2.3 1.27l9.344-5.891a1.5 1.5 0 0 0 0-2.538L6.3 2.841Z"/>
</svg></button><section class="intro wrap"><h1><span class="headline-first">Useful things</span><em class="headline-second">made with <span class="curiosity">curiosity</span></em></h1></section><section class="postcards wrap" aria-label="Personal projects"><a class="postcard kindle" href="/projects/kindle-newspaper"><div class="postcard-art"><img src="/river-assets/kindle.png" alt="" width="1536" height="1024"></div><h2>Kindle newspaper</h2><p>A nightly edition for my Kindle.</p></a><a class="postcard parcel" href="/articles/parcelrouter-from-inbox-script-to-package-event-router"><div class="postcard-art"><img src="/river-assets/parcel.png" alt="" width="1536" height="1024"></div><h2>ParcelRouter</h2><p>Shipping emails to package events.</p></a><a class="postcard gif" href="/articles/making-gifs-small-enough-for-a-conversation"><div class="postcard-art"><img src="/river-assets/gif.png" alt="" width="1536" height="1024"></div><h2>Tiny GIFs</h2><p>Good motion, smaller files.</p></a></section><RecentWriting articles={recentArticles} />
</MainLayout>
