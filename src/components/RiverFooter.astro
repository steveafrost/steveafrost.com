---
import ArrowRight from './ArrowRight.astro';
import ThemeSwitch from './ThemeSwitch.astro';
---
<footer class="river-footer river-footer-edge">
  <div class="footer-art" aria-hidden="true">
    {(['day','night'] as const).map(theme => <div class={`footer-art-theme footer-art-${theme}`}>
      <img class="footer-cap" src={`/footer-assets/${theme}-cap.webp`} width="2172" height="340" alt="" fetchpriority="low" decoding="async" />
      <img class="footer-paper" src={`/footer-assets/${theme}-paper.webp`} width="2172" height="220" alt="" fetchpriority="low" decoding="async" />
      <img class="footer-water" src={`/footer-assets/${theme}-water.webp`} width="2172" height="164" alt="" fetchpriority="low" decoding="async" />
    </div>)}
  </div>
  <div class="footer-inner">
    <div class="footer-main">
      <div class="footer-identity">
        <a class="footer-name" href="/">Steve Frost</a>
        <p>Useful things made with curiosity.</p>
      </div>
      <nav class="footer-links" aria-label="Footer">
        <a href="/projects"><span>More work</span><ArrowRight /></a>
        <a class="footer-github" href="https://github.com/steveafrost"><span>GitHub</span><ArrowRight /></a>
      </nav>
    </div>
    <div class="footer-meta">
      <ThemeSwitch footer />
    </div>
  </div>
</footer>

<style>
  .river-footer-edge{--footer-ink:#081f1b;--footer-muted:#425c53;--footer-line:rgb(8 31 27 / 22%);--footer-water-height:64px;position:relative;isolation:isolate;display:block;max-width:none;margin-top:48px;padding:0 0 var(--footer-water-height);border:0;color:var(--footer-ink);font-family:'Space Grotesk',RiverSans,Arial,sans-serif}
  :global([data-theme="night"]) .river-footer-edge{--footer-ink:#f5edd9;--footer-muted:#bbc6b9;--footer-line:rgb(245 237 217 / 25%)}
  .footer-art,.footer-art-theme{position:absolute;inset:0;pointer-events:none}
  .footer-art{z-index:-1}
  .footer-art img{position:absolute;left:0;width:100%;max-width:none;pointer-events:none}
  .footer-cap{top:0;height:112px;object-fit:fill}
  .footer-paper{top:112px;height:calc(100% - 112px - var(--footer-water-height));object-fit:fill}
  .footer-water{bottom:0;height:var(--footer-water-height);object-fit:cover;object-position:center bottom}
  .footer-art-night{display:none}
  :global([data-theme="night"]) .footer-art-day{display:none}
  :global([data-theme="night"]) .footer-art-night{display:block}
  .footer-inner{position:relative;width:calc(100% - 2 * clamp(24px,8vw,82px));max-width:1240px;margin-inline:auto;padding-top:92px;padding-bottom:12px}
  .footer-main{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,340px);align-items:center;gap:clamp(40px,6vw,100px)}
  .footer-identity{min-width:0}
  .footer-name{display:inline-block;min-height:44px;max-width:100%;color:var(--footer-ink);font:600 clamp(54px,7vw,104px)/1.04 Fraunces,Georgia,serif;font-variation-settings:'SOFT' 0,'WONK' 1,'opsz' 144;letter-spacing:-.055em;text-decoration:none;overflow-wrap:anywhere}
  .footer-identity p{margin:8px 0 0;color:var(--footer-muted);font-size:clamp(19px,2vw,26px);line-height:1.4}
  .footer-links{border-left:1px solid var(--footer-line);padding-left:clamp(32px,4vw,64px);min-width:0}
  .footer-links a{display:flex;align-items:center;gap:18px;width:fit-content;max-width:100%;min-height:56px;color:var(--footer-ink);font:500 clamp(30px,3vw,44px)/1.2 Fraunces,Georgia,serif;letter-spacing:-.035em;text-decoration:none;padding-block:8px}
  .footer-links a+a{border-top:1px solid var(--footer-line)}
  .footer-links a span{min-width:0;overflow-wrap:anywhere}
  .footer-links :global(svg){flex-shrink:0;width:32px;height:32px;color:var(--red)}
  .footer-github :global(svg){transform:rotate(-45deg)}
  .footer-meta{display:flex;align-items:center;justify-content:flex-end;flex-wrap:wrap;gap:8px 24px;border-top:1px solid var(--footer-line);margin-top:32px;padding-top:12px;color:var(--footer-muted);font-size:18px;line-height:1.5}
  .footer-meta p{margin:0;overflow-wrap:anywhere}
  .footer-meta :global(.theme-footer){display:inline-flex;align-items:center;justify-content:center;gap:10px;grid-area:auto;width:auto;height:auto;min-height:44px;margin:0;padding:4px 0;background:transparent;border:0;border-radius:0;color:var(--footer-muted);font:inherit;white-space:nowrap}
  .footer-meta :global(.theme-footer svg){width:28px;height:28px;color:var(--red)}
  .footer-meta :global(.theme-footer .theme-header-sun){display:block;width:28px;height:28px}
  .footer-meta :global(.theme-footer .theme-header-moon){display:none;width:28px;height:28px}
  .footer-meta :global(.theme-footer .footer-night-label){display:none}
  :global([data-theme="night"]) .footer-meta :global(.theme-footer .theme-header-sun),:global([data-theme="night"]) .footer-meta :global(.theme-footer .footer-day-label){display:none}
  :global([data-theme="night"]) .footer-meta :global(.theme-footer .theme-header-moon),:global([data-theme="night"]) .footer-meta :global(.theme-footer .footer-night-label){display:block}
  .footer-name:hover,.footer-links a:hover{text-decoration:underline;text-underline-offset:.12em;text-decoration-thickness:1px}
  .footer-meta :global(.theme-footer:hover){text-decoration:underline;text-underline-offset:4px;background:transparent}
  .footer-name:focus-visible,.footer-links a:focus-visible,.footer-meta :global(.theme-footer:focus-visible){outline:2px solid var(--red);outline-offset:6px}
  :global(body.river-home) .river-footer-edge{padding-left:0;padding-right:0}
  :global(body.river-home) .footer-inner{width:calc(100% - 2 * clamp(24px,8vw,82px) - var(--home-safe-left) - var(--home-safe-right))}
  @media(max-width:760px){
    .river-footer-edge{--footer-water-height:56px;margin-top:32px}
    .footer-inner{padding-top:64px}
    .footer-main{grid-template-columns:minmax(0,1fr);gap:26px}
    .footer-name{font-size:clamp(40px,10vw,56px);line-height:1.08;letter-spacing:-.045em}
    .footer-identity p{font-size:clamp(16px,4vw,21px);line-height:1.4;margin-top:4px}
    .footer-links{border-left:0;border-top:1px solid var(--footer-line);padding:0}
    .footer-links a{font-size:clamp(25px,5.5vw,29px);min-height:44px;padding-block:8px;gap:14px}
    .footer-links a+a{width:100%}
    .footer-links :global(svg){width:26px;height:26px}
    .footer-meta{margin-top:28px;font-size:clamp(14px,3.6vw,18px);gap:4px 16px}
    .footer-meta :global(.theme-footer){gap:8px}
  }
  @media(forced-colors:active){.footer-art{display:none}.river-footer-edge{color:CanvasText;background:Canvas;--footer-ink:CanvasText;--footer-muted:CanvasText;--footer-line:CanvasText}.footer-links :global(svg),.footer-meta :global(.theme-footer svg){color:LinkText}}
</style>
