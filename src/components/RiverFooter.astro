---
import ThemeSwitch from './ThemeSwitch.astro';
---
<footer class="river-footer river-footer-minimal">
  <div class="footer-inner">
    <a class="footer-name" href="/">Steve Frost</a>
    <nav class="footer-links" aria-label="Footer">
      <a href="/projects">More work</a>
      <a href="https://github.com/steveafrost">GitHub</a>
    </nav>
    <ThemeSwitch footer />
  </div>
</footer>

<style>
  .river-footer-minimal{--footer-line:rgb(19 43 40 / 22%);display:block;max-width:none;margin-top:48px;padding:0;border:0;color:var(--ink);background:var(--cream);font-family:RiverSans,Arial,sans-serif}
  :global([data-theme="night"]) .river-footer-minimal{--footer-line:rgb(245 237 217 / 65%)}
  .footer-inner{display:grid;grid-template-columns:minmax(0,1fr) auto 44px;grid-template-areas:'name links theme';align-items:center;gap:32px;width:calc(100% - 2 * clamp(24px,6vw,80px));max-width:1240px;margin-inline:auto;border-top:1px solid var(--footer-line);padding-block:24px}
  .footer-name{grid-area:name;justify-self:start;display:inline-flex;align-items:center;min-height:44px;max-width:100%;color:inherit;font-size:20px;font-weight:600;line-height:1.25;letter-spacing:-.025em;overflow-wrap:anywhere}
  .footer-links{grid-area:links;display:flex;align-items:center;flex-wrap:wrap;gap:16px 40px;font-size:16px;font-weight:500;line-height:1.5}
  .footer-links a{display:inline-flex;align-items:center;min-height:44px;color:inherit}
  .footer-inner :global(.theme-footer){grid-area:theme;display:inline-grid;place-items:center;width:44px;height:44px;min-width:44px;min-height:44px;margin:0;padding:7px;border:0;border-radius:0;background:transparent;color:inherit}
  .footer-inner :global(.theme-footer svg){width:30px;height:30px}
  .footer-inner :global(.theme-footer .theme-header-sun){display:block;width:30px;height:30px}
  .footer-inner :global(.theme-footer .theme-header-moon){display:none;width:30px;height:30px}
  :global([data-theme="night"]) .footer-inner :global(.theme-footer .theme-header-sun){display:none}
  :global([data-theme="night"]) .footer-inner :global(.theme-footer .theme-header-moon){display:block}
  .footer-name:hover,.footer-links a:hover{text-decoration:underline;text-underline-offset:5px;text-decoration-thickness:1px}
  .footer-inner :global(.theme-footer:hover){background:transparent;color:var(--red)}
  .footer-name:focus-visible,.footer-links a:focus-visible,.footer-inner :global(.theme-footer:focus-visible){outline:2px solid var(--red);outline-offset:5px}
  :global(body.river-home) .river-footer-minimal{padding-left:0;padding-right:0}
  :global(body.river-home) .footer-inner{width:calc(100% - 2 * clamp(24px,6vw,80px) - var(--home-safe-left) - var(--home-safe-right))}
  @media(max-width:760px){
    .river-footer-minimal{margin-top:32px}
    .footer-inner{grid-template-columns:minmax(0,1fr) 44px;grid-template-areas:'name theme' 'links links';gap:8px 16px;width:calc(100% - 2 * clamp(24px,12vw,60px));padding-top:16px;padding-bottom:24px}
    .footer-links{gap:12px 36px}
    :global(body.river-home) .footer-inner{width:calc(100% - 2 * clamp(24px,12vw,60px) - var(--home-safe-left) - var(--home-safe-right))}
  }
  @media(forced-colors:active){.river-footer-minimal{color:CanvasText;background:Canvas}.footer-inner{border-color:CanvasText}}
</style>
