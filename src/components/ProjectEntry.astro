---
import type { Project } from "../data/projects";
interface Props { project: Project; featured?: boolean }
const { project, featured = false } = Astro.props;
const href = `/projects/${project.slug}`;
---
<article class:list={["work-entry", featured ? "work-entry--featured" : "work-entry--list"]} aria-labelledby={`work-${project.slug}`}>
  <a class="work-preview" href={href} aria-label={`View ${project.name} project`}>
    <img src={`/img/projects/${project.slug}.png`} alt={`${project.name} project preview`} width="1280" height="720" loading={featured ? "eager" : "lazy"} decoding="async" />
  </a>
  <div class="work-identity">
    <h2 id={`work-${project.slug}`}><a href={href}>{project.name}</a></h2>
    <p class="work-role">{project.role}</p>
  </div>
  <p class="work-description">{project.description}</p>
  <div class="work-actions">
    <a class="work-open" href={href} aria-label={`View ${project.name} project`}>View project
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
    </a>
    {project.github && <a class="work-source" href={project.github} target="_blank" rel="noopener noreferrer" aria-label={`View source for ${project.name} (opens in a new tab)`}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" /></svg>
      View source
    </a>}
  </div>
</article>
<style>
  .work-entry{min-width:0;font-family:'Space Grotesk',RiverSans,sans-serif}
  .work-preview{display:block;min-width:0;overflow:hidden;border-radius:4px}
  .work-preview img{width:100%;height:auto;aspect-ratio:16/9;object-fit:cover;object-position:top;transition:transform .2s ease}
  .work-entry h2{font:700 32px/1.15 Fraunces,Georgia,serif;font-variation-settings:'SOFT' 100,'WONK' 1;letter-spacing:-.035em;color:var(--ink);margin:0;text-wrap:balance;overflow-wrap:anywhere}
  .work-entry h2 a{display:inline-block}
  .work-role{font-size:17px;line-height:1.5;color:var(--olive);margin:8px 0 0}
  .work-description{font-size:18px;line-height:1.55;color:var(--olive);margin:0;overflow-wrap:anywhere}
  .work-actions{display:flex;align-items:flex-start;flex-wrap:wrap;gap:10px 24px;min-width:0}
  .work-actions a{display:inline-flex;align-items:center;gap:10px;min-height:44px;font-size:16px;line-height:1.4}
  .work-open{color:var(--red)}
  .work-source{color:var(--olive)}
  .work-actions svg{flex-shrink:0}
  .work-entry--featured{display:flex;flex-direction:column;align-items:flex-start}
  .work-entry--featured .work-preview{width:100%;margin-bottom:22px}
  .work-entry--featured h2{font-size:36px}
  .work-entry--featured .work-description{margin-top:8px}
  .work-entry--featured .work-actions{margin-top:20px}
  .work-entry--featured .work-open{border:1px solid currentColor;border-radius:30px;padding:10px 24px}
  .work-entry--list{display:grid;grid-template-columns:240px minmax(0,1.15fr) minmax(0,1.55fr) 150px;gap:36px;align-items:start;padding:26px 0;border-top:1px solid var(--line)}
  .work-entry--list .work-actions{flex-direction:column;gap:0}
  .work-entry--list .work-preview{align-self:start}
  @media(hover:hover){.work-preview:hover img{transform:translateY(-2px)}}
  @media(max-width:1199px){
    .work-entry--list{grid-template-columns:170px minmax(0,1fr) minmax(0,1.4fr) 130px;gap:24px}
    .work-entry--list h2{font-size:27px}
    .work-description{font-size:17px}
    .work-role{font-size:16px}
  }
  @media(max-width:899px){
    .work-entry--list{grid-template-columns:140px minmax(0,1fr);gap:12px 24px;padding:28px 0}
    .work-entry--list .work-preview{grid-column:1;grid-row:1}
    .work-entry--list .work-identity{grid-column:2;grid-row:1}
    .work-entry--list .work-description{grid-column:1/-1;grid-row:2}
    .work-entry--list .work-actions{grid-column:1/-1;grid-row:3;flex-direction:row;gap:12px 24px}
    .work-entry--list .work-open{border:1px solid currentColor;border-radius:30px;padding:10px 20px}
    .work-description{font-size:18px;line-height:1.6}
    .work-entry--featured h2{font-size:30px}
  }
  @media(max-width:520px){
    .work-entry--list{grid-template-columns:96px minmax(0,1fr);gap:14px 18px}
    .work-entry--list h2{font-size:22px;line-height:1.18}
    .work-role{font-size:14px;margin-top:6px}
    .work-description{font-size:16px;line-height:1.55}
    .work-entry--featured h2{font-size:26px}
    .work-entry--featured .work-preview{margin-bottom:16px}
    .work-entry--featured .work-actions{margin-top:16px}
    .work-actions a{font-size:16px}
  }
  @media(prefers-reduced-motion:reduce){.work-preview img{transition:none}.work-preview:hover img{transform:none}}
</style>
