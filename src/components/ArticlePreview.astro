---
import ArrowRight from './ArrowRight.astro';
import type { CollectionEntry } from 'astro:content';
interface Props { article: CollectionEntry<'articles'>; lead?: boolean; archive?: boolean; }
const { article, lead = false, archive = false } = Astro.props;
const date = article.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
const minutes = Math.max(1, Math.ceil((article.body ?? '').replace(/^---[\s\S]*?---/, '').trim().split(/\s+/).length / 250));
const opening = (article.body ?? '').split(/\n\s*\n/).find(p => /^[A-Za-z“‘]/.test(p.trim())) ?? '';
const plain = (article.data.description || opening).replace(/\[([^\]]+)\]\([^)]*\)/g, '$1').replace(/[*_`]/g, '').replace(/\s+/g, ' ').trim();
const limit = lead ? 320 : 190;
const excerpt = plain.length > limit ? plain.slice(0, limit).replace(/\s+\S*$/, '') + '…' : plain;
const href = `/articles/${article.id}`;
---
<article class:list={['reading-preview', { lead, archive }]} data-search={`${article.data.title} ${plain} ${(article.data.tags ?? []).join(' ')}`} data-tags={JSON.stringify(article.data.tags ?? [])}>
  {lead && <a href={href} class="lead-image" aria-label={article.data.title}><img src="/river-assets/kindle.png" alt="A Kindle and newspaper on a sunny table overlooking a village." width="1536" height="1024" fetchpriority="high" /></a>}
  <p class="reading-meta"><time datetime={article.data.date.toISOString()}>{date}</time><span aria-hidden="true"> · </span>{minutes} min read</p>
  <h3><a href={href}>{article.data.title}</a></h3>
  <p class="reading-excerpt">{excerpt}</p>
  <a href={href} class="reading-link" aria-label={`Read ${article.data.title}`}>Read article <ArrowRight /></a>
</article>
<style>
.reading-preview{min-width:0}.reading-meta{font-size:13px;line-height:1.5;color:var(--olive);margin:0 0 10px;font-variant-numeric:tabular-nums}h3{font:400 28px/1.15 Georgia,'Times New Roman',serif;letter-spacing:-.025em;margin:0 0 13px;text-wrap:pretty}h3 a{text-decoration:none;color:var(--ink)}h3 a:hover{color:var(--red)}.reading-excerpt{font:400 17px/1.55 Georgia,'Times New Roman',serif;color:var(--olive);margin:0 0 16px}.reading-link{display:inline-flex;align-items:center;gap:10px;color:var(--red);font-size:14px;padding-block:8px;text-decoration:none}.reading-link:hover{text-decoration:underline;text-underline-offset:5px}.lead-image{display:block;margin-bottom:16px}.lead-image img{width:100%;aspect-ratio:2.15;object-fit:cover;border-radius:2px}.lead h3{font-size:clamp(28px,2.5vw,38px)}.lead .reading-excerpt{font-size:19px}.archive h3{font-size:23px}.archive .reading-excerpt{font-size:16px;margin-bottom:4px}.archive .reading-meta{margin-bottom:8px}.archive .reading-link{font-size:13px}a:focus-visible{outline:2px solid var(--red);outline-offset:5px}@media(max-width:640px){h3{font-size:25px}.lead-image img{aspect-ratio:1.65}.lead .reading-excerpt{font-size:17px}}
</style>
