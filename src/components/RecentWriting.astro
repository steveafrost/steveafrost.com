---
import type { CollectionEntry } from 'astro:content';
import ArrowRight from './ArrowRight.astro';
interface Props { articles: CollectionEntry<'articles'>[]; }
const { articles } = Astro.props;
const formatDate = (date: Date) => date.toLocaleDateString('en-US', {
  year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC',
});
---
<section class="recent-writing wrap" aria-labelledby="recent-writing-title">
  <div class="recent-writing-heading">
    <h2 id="recent-writing-title">Recently written</h2>
    <a class="all-writing" href="/articles">All writing <ArrowRight /></a>
  </div>
  <div class="recent-writing-list">
    {articles.map(article => (
      <article class="recent-writing-entry">
        <a class="recent-writing-link" href={`/articles/${article.id}`}>
          <div class="recent-writing-copy">
            <time datetime={article.data.date.toISOString()}>{formatDate(article.data.date)}</time>
            <h3>{article.data.title}</h3>
          </div>
          <ArrowRight />
        </a>
      </article>
    ))}
  </div>
</section>
<style>
  .recent-writing{margin-top:var(--home-section-space,64px);font-family:'Space Grotesk',RiverSans,Arial,sans-serif}
  .recent-writing-heading{display:flex;align-items:baseline;justify-content:space-between;gap:24px;margin-bottom:18px}
  h2{font:500 clamp(36px,4vw,56px)/1.12 Fraunces,Georgia,serif;letter-spacing:-.035em;margin:0;color:var(--ink)}
  .all-writing{display:inline-flex;align-items:center;gap:10px;min-height:44px;color:#bf321e;font-size:15px;white-space:nowrap;text-decoration:underline;text-underline-offset:5px}
  .recent-writing-entry{border-bottom:1px solid var(--line)}
  .recent-writing-entry:last-child{border-bottom:0}
  .recent-writing-link{display:grid;grid-template-columns:minmax(0,1fr) 24px;align-items:center;gap:32px;padding:26px 0;color:var(--ink);text-decoration:none}
  .recent-writing-copy{min-width:0}
  time{display:block;font-size:14px;line-height:1.5;color:var(--olive);font-variant-numeric:tabular-nums;margin-bottom:7px}
  h3{font:400 clamp(24px,2.3vw,32px)/1.2 Fraunces,Georgia,serif;letter-spacing:-.025em;margin:0;text-wrap:pretty;overflow-wrap:anywhere}
  .recent-writing-link :global(svg){width:24px;height:24px;color:#bf321e}
  .recent-writing-link:hover{text-decoration:none}
  .recent-writing-link:hover h3{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:6px}
  .recent-writing-link:focus-visible,.all-writing:focus-visible{outline:2px solid var(--red);outline-offset:6px}
  :global([data-theme="night"]) .all-writing,:global([data-theme="night"]) .recent-writing-link :global(svg){color:#ff917b}
  @media(max-width:600px){
    .recent-writing-heading{gap:14px;align-items:center;margin-bottom:8px;flex-wrap:wrap}
    h2{font-size:32px;line-height:1.15}
    .all-writing{font-size:13px;gap:6px}
    .all-writing :global(svg){width:16px;height:16px}
    .recent-writing-link{gap:20px;padding:24px 0}
    h3{font-size:24px;line-height:1.22}
    time{font-size:13px;margin-bottom:6px}
  }
  @media(forced-colors:active){.all-writing,.recent-writing-link :global(svg){color:LinkText}}
</style>
