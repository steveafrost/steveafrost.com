---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import browserChromeSource from "../../public/river-assets/browser-chrome.js?raw";


import Analytics from "@vercel/analytics/astro";
import ThemeSwitch from "../components/ThemeSwitch.astro";
import NavigationIcon from "../components/NavigationIcon.astro";
import { landscapeImage, resolveSocialImage } from "../lib/social-image.mjs";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article";
  home?: boolean;
  glassHeader?: boolean;
  browserTemplate?: "featurette" | "featurette-screen";
}

const {
  title = "Steve Frost - Software Engineer",
  description = "Front-end engineer building useful and beautiful web experiences.",
  ogImage,
  ogImageAlt,
  ogType = "website",
  home = false,
  glassHeader = false,
  browserTemplate,
} = Astro.props;

const navLinks = [
  { href: "/projects", label: "Work" },
  { href: "/articles", label: "Writing" },
  { href: "/about", label: "About" },
] as const;

const currentPath = Astro.url.pathname;
const useGlassHeader = home || glassHeader || ["/about", "/projects", "/articles"].includes(currentPath.replace(/\/$/, ""));
const chromeTemplate = browserTemplate || (home ? "home" : (currentPath.startsWith("/articles/") && currentPath !== "/articles/") ? "article" : currentPath === "/about" || currentPath === "/about/" ? "about" : "list");
const chromeColors = {
  home: ["#c2dcd3", "#001b32"],
  featurette: ["#f4e9d6", "#f4e9d6"],
  "featurette-screen": ["#f7f4eb", "#10222d"],
  article: ["#f7f4eb", "#10222d"],
  about: ["#f7f4eb", "#f7f4eb"],
  list: ["#f7f4eb", "#10222d"],
} as const;
const [chromeDay, chromeNight] = chromeColors[chromeTemplate];
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImage = (ogImage && resolveSocialImage(ogImage, ogImageAlt || title, Astro.site!)) || resolveSocialImage(landscapeImage.src, landscapeImage.alt, Astro.site!);
if (!socialImage) throw new Error("The default landscape social image is missing or invalid.");
---

<html lang="en" data-browser-template={chromeTemplate} data-chrome-day={chromeDay} data-chrome-night={chromeNight} style={`background-color:${chromeDay};color-scheme:light`}>
  <head>
    <ClientRouter />
    <meta name="theme-color" content={chromeDay} />
    <meta name="color-scheme" content="light" />
    <script is:inline set:html={browserChromeSource} />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico?v=selected-river-3" sizes="16x16 32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=selected-river-3" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-32.png?v=selected-river-3" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=selected-river-3" sizes="180x180" />
    <link rel="canonical" href={canonicalUrl.href} />

    <!-- Self-hosted font preloads (critical weights only) -->
    <link
      rel="preload"
      href="/fonts/inter-latin-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin-600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:site_name" content="Steve Frost" />
    <meta property="og:image" content={socialImage.src} />
    <meta property="og:image:secure_url" content={socialImage.src} />
    <meta property="og:image:type" content={socialImage.type} />
    <meta property="og:image:width" content={String(socialImage.width)} />
    <meta property="og:image:height" content={String(socialImage.height)} />
    <meta property="og:image:alt" content={socialImage.alt} />

    <!-- Twitter Card -->
    <meta
      name="twitter:card"
      content="summary_large_image"
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:url" content={canonicalUrl.href} />
    <meta name="twitter:image" content={socialImage.src} />
    <meta name="twitter:image:alt" content={socialImage.alt} />

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {home && <link rel="preload" as="image" href="/river-assets/moon-source.png" />}
    <link rel="stylesheet" href="/river-assets/river.css?v=lamp-controls-1" />
    <link rel="stylesheet" href="/river-assets/production.css?v=featurette-viewport-1" />
    <Analytics />
  </head>
  <body class:list={["river-site", home ? "river-home" : "river-inner", !home && useGlassHeader && "river-glass-inner"]}>
    <a class="skip" href="#main">Skip to content</a>
    <header class:list={["river-nav wrap editorial-header", useGlassHeader && "glass-navigation"]}>
      <a class="river-brand" href="/"><span class="brand-name">Steve Frost</span></a>
      <button class="mobile-menu-toggle" type="button" aria-label="Open navigation" title="Open navigation" aria-expanded="false" aria-controls="header-menu" hidden>
        <span class="menu-open-icon"><NavigationIcon name="dots" /></span>
        <span class="menu-close-icon"><NavigationIcon name="close" /></span>
      </button>
      <div id="header-menu" class="header-menu">
        <nav aria-label="Primary">
          {navLinks.map(({ href, label }) => <a href={href} aria-current={currentPath.startsWith(href) ? "page" : undefined}>{label}</a>)}
        </nav>
        <div class="header-utilities">
          <div class="header-social-links">
            <a href="mailto:hello@steveafrost.com" aria-label="Email Steve Frost" title="Email Steve Frost"><NavigationIcon name="mail" /></a>
            <a href="https://github.com/steveafrost" aria-label="Steve Frost on GitHub" title="GitHub" target="_blank" rel="noopener noreferrer"><NavigationIcon name="github" /></a>
            <a href="https://www.linkedin.com/in/steveafrost" aria-label="Steve Frost on LinkedIn" title="LinkedIn" target="_blank" rel="noopener noreferrer"><NavigationIcon name="linkedin" /></a>
          </div>
          <ThemeSwitch />
        </div>
      </div>
    </header>
    <main id="main" class:list={[!home && "river-content wrap"]}><slot /></main>
    <footer class="river-footer wrap"><a href="/">Steve Frost</a><a href="/projects">More work</a><a href="https://github.com/steveafrost">GitHub</a></footer>
    <script is:inline defer src="/river-assets/navigation-lifecycle.js?v=router-chrome-3"></script>
    <script is:inline defer src="/river-assets/theme.js?v=header-editorial-1-chrome-1"></script>
    <script is:inline defer src="/river-assets/mobile-menu.js?v=unfold-2-router-1"></script>
    {home && <script is:inline defer src="/river-assets/river.js?v=unified-motion-8-router-1"></script>}
    {home && <script is:inline type="module" src="/river-assets/bank-visitors.mjs?v=exact-start-6-router-1"></script>}
    {home && <script is:inline type="module" src="/river-assets/bridge-cyclist.mjs?v=exact-start-4-router-1"></script>}
    {home && <script is:inline type="module" src="/river-assets/tower-flag.mjs?v=exact-start-3-router-1"></script>}
    {useGlassHeader && <script is:inline defer src="/river-assets/sticky-glass.js?v=mobile-stable-1-router-1"></script>}
  </body>
</html>
