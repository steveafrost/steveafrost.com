---
import "../styles/global.css";


import Analytics from "@vercel/analytics/astro";
import ThemeSwitch from "../components/ThemeSwitch.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  home?: boolean;
}

const {
  title = "Steve Frost - Software Engineer",
  description = "Front-end engineer building useful and beautiful web experiences.",
  ogImage,
  home = false,
} = Astro.props;

const navLinks = [
  { href: "/projects", label: "Work" },
  { href: "/articles", label: "Writing" },
  { href: "/about", label: "About" },
] as const;

const currentPath = Astro.url.pathname;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('river-theme')==='night'?'night':'day'}catch{document.documentElement.dataset.theme='day'}</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl.href} />

    <!-- Self-hosted font preloads (critical weights only) -->
    <link
      rel="preload"
      href="/fonts/inter-latin-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin-600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:site_name" content="Steve Frost" />
    {
      ogImage && (
        <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
      )
    }

    <!-- Twitter Card -->
    <meta
      name="twitter:card"
      content={ogImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {
      ogImage && (
        <meta
          name="twitter:image"
          content={new URL(ogImage, Astro.site).href}
        />
      )
    }

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {home && <link rel="preload" as="image" href="/river-assets/moon-source.png" />}
    <link rel="stylesheet" href="/river-assets/river.css?v=lamp-controls-1" />
    <link rel="stylesheet" href="/river-assets/production.css?v=liquid-preview-3" />
    <Analytics />
  </head>
  <body class:list={["river-site", home ? "river-home" : "river-inner"]}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="river-nav wrap editorial-header">
      <a class="river-brand" href="/"><span class="brand-name">Steve Frost</span></a>
      <nav aria-label="Primary">
        {navLinks.map(({ href, label }) => <a href={href} aria-current={currentPath.startsWith(href) ? "page" : undefined}>{label}</a>)}
      </nav>
      <ThemeSwitch />
      {home && <canvas class="glass-optics" aria-hidden="true"></canvas>}
    </header>
    <main id="main" class:list={[!home && "river-content wrap"]}><slot /></main>
    <footer class="river-footer wrap"><a href="/">Steve Frost</a><a href="/projects">More work</a><a href="https://github.com/steveafrost">GitHub</a></footer>
    <script is:inline defer src="/river-assets/theme.js?v=header-editorial-1"></script>
    {home && <script is:inline defer src="/river-assets/river.js?v=river-precise-2"></script>}
    {home && <script is:inline defer src="/river-assets/glass.js?v=liquid-preview-3"></script>}
  </body>
</html>
